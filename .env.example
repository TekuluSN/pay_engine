RZP_SIM_PORT=4010

# Credentials the ERP uses against the simulator (HTTP Basic, same as real Razorpay).
RZP_SIM_KEY_ID=rzp_test_simulator
RZP_SIM_KEY_SECRET=simulator_secret

# Where events are POSTed. Leave empty to only record them at GET /simulator/webhooks.
RZP_SIM_WEBHOOK_URL=
RZP_SIM_WEBHOOK_SECRET=simulator_webhook_secret

# true: a successful payment is captured immediately (Razorpay "auto-capture").
RZP_SIM_AUTO_CAPTURE=true
RZP_SIM_FEE_PERCENT=2.0
